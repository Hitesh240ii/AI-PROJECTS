# Copy this file to .env and fill in your key. NEVER commit .env.
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

EMBEDDING_MODEL=all-MiniLM-L6-v2

# Leave QDRANT_URL empty to use embedded local storage in ./qdrant_storage.
# Set it (e.g. http://localhost:6333) to use a Qdrant Docker container.
QDRANT_URL=
QDRANT_PATH=qdrant_storage
QDRANT_COLLECTION=knowledge_base

# Chunking (in words). MiniLM truncates at ~256 word-pieces, so keep chunks <= ~200 words.
CHUNK_SIZE=180
CHUNK_OVERLAP=30
MIN_CHUNK_WORDS=20

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.30
MAX_CONTEXT_CHARS=6000

# Limits / logging
MAX_UPLOAD_MB=20
MAX_DOC_CHUNKS=5000
LOG_LEVEL=INFO
